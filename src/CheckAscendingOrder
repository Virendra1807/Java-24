import java.util.*;

public class Main {
    public static void main(String ar[]){
        // Check the array is in ascending order or not
        int []arr = {1,2,3,4,5,6,8,9};
        
        Main obj = new Main();
        
        if(obj.checkAscending(arr)){
            System.out.println("Array in ascending order");
        }else{
            System.out.println("Array not in ascending order");
        }
    }
    
    public boolean checkAscending(int arr1[]){
        
        for(int i = 0; i < arr1.length-1; i++){
            if(arr1[i] > arr1[i+1]){
                return false;
            }
        }
        return true;   
    }
}

